{
  "version": 2,
  "builds": [
    { "src": "api/**/*.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "/includes/(.*)", "status": 404 },
    { "src": "/sql/(.*)", "status": 404 },
    { "src": "/data/(.*)", "status": 404 },
    { "src": "/(assets|public|src)/(.*)", "dest": "/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
