{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/includes/(.*)", "status": 404 },
    { "src": "/sql/(.*)", "status": 404 },
    { "src": "/data/(.*)", "status": 404 },
    { "src": "/src/(.*)", "status": 404 },
    { "src": "/(assets|public)/(.*)", "dest": "/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
